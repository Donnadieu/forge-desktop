# Copy to .env (git-ignored) and fill in. Forge Desktop's own commits use these;
# `make hooks` writes them into this clone's local git config, and
# tools/check-identity.sh checks every commit against them. The app never reads this file.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
FORGE_GIT_SIGNING_KEY=

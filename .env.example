# Copy to .env (git-ignored) and fill in. Forge Desktop's own commits use these;
# `make hooks` writes them into this clone's local git config, and
# tools/check-identity.sh checks every commit against them. The app never reads this file.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
FORGE_GIT_SIGNING_KEY=

# Release signing (./build.sh --package / --install). All optional: without them builds are ad hoc.
# FORGE_SIGN_ID=              codesigning identity; default: the first "Developer ID Application" on this Mac
# FORGE_SIGN_KEYCHAIN=        a keychain to unlock before signing
# FORGE_SIGN_KEYCHAIN_ITEM=   login-Keychain item (service) holding that keychain's password
# FORGE_NOTARY_PROFILE=       notarytool keychain profile (xcrun notarytool store-credentials)
# FORGE_UPDATE_REPO=          owner/repo the in-app updater reads releases from; default: this clone's origin

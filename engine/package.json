{
  "name": "forge-desktop-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The board engine Forge Desktop runs beside the app. Copied from Forge; see README.md and PROVENANCE.md.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsc && cp src/observability/secret-spec.json dist/observability/secret-spec.json",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit && vitest run",
    "fix": "biome check --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "gray-matter": "^4.0.3",
    "liquidjs": "^10.17.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.2.0",
    "ws": "^8.22.1",
    "zod": "^3.23.0"
  }
}
